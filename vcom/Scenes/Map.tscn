[node name="Rivers" type="Node2D" parent="." unique_id=280527989]
editor_description = "The rivers, numbered by the water they carry as MapCreation/SourceData/Rivers.json has them. A river's width is its width at its widest; its width curve narrows it from there toward its source. A river that reaches the sea runs on a little into the coast's line."

