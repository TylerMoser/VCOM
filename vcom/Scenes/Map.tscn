[node name="Party" type="Node2D" parent="." unique_id=1637420915]
editor_description = "The player's party, the red dot, drawn over the settlements. Where it is here is where it starts: near the middle of county 115. A right click sends it there (on a settlement's icon, to the settlement), and it goes in a straight line, over water as over land: this map has no land for it to keep to yet, which is why its Terrain Path is empty. Its speed and its steps are in the map's units, 100 m each."
position = Vector2(7302, 7381)
script = ExtResource("5_party")
