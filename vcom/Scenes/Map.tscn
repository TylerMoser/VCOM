[node name="Coast" type="Node2D" parent="." unique_id=21937789]
editor_description = "The coast's black line, 23 units wide, all of it outside the land. Each stretch is named for the county whose shore it is (CoastOfCounty003; a county with several has CoastOfCounty003b and so on). It is a line twice that wide along the land's edge, with the same points as that county's polygon, and the land is drawn over its inner half."

