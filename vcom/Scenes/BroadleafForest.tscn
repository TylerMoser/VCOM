[node name="BroadleafForest" instance=ExtResource("1_forest")]
editor_description = "A broadleaf forest on the new map (Scenes/Map.tscn): the Deciduous Forest's, the Temperate Mountains' lower slopes, the trees along the water in the Grassland and the Desert, and the Swamp's drier ground. A Forest, so the party may be set upon in it, at Forest.tscn's odds; this scene sets only its colour, a soft yellow-green, see-through over the land."
