[ext_resource type="Resource" uid="uid://d2l5k82w4sccd" path="res://Resources/Rifle.tres" id="4_rifle"]
[ext_resource type="Resource" uid="uid://de4cpifu51rip" path="res://Resources/Items/LightArmor.tres" id="5_light_armor"]
[ext_resource type="Resource" uid="uid://ben8g8m4b4vgv" path="res://Resources/Items/FragGrenade.tres" id="6_frag_grenade"]
