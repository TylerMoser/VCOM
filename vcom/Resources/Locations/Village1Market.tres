[sub_resource type="Resource" id="Resource_stock"]
script = ExtResource("2_inventory")
stacks = Array[ExtResource("3_stack")]([SubResource("Resource_rifle"), SubResource("Resource_shortsword"), SubResource("Resource_light_armor"), SubResource("Resource_frag_grenade")])

[resource]
script = ExtResource("1_market")
stock = SubResource("Resource_stock")
display_name = "Market"
description = "Traders here deal in weapons, armor and supplies."
