[gd_resource type="Resource" script_class="Market" format=3]

[ext_resource type="Script" path="res://Scripts/WorldMap/Market.gd" id="1_market"]
[ext_resource type="Script" path="res://Scripts/Items/Inventory.gd" id="2_inventory"]
[ext_resource type="Script" path="res://Scripts/Items/ItemStack.gd" id="3_stack"]
[ext_resource type="Resource" path="res://Resources/Rifle.tres" id="4_rifle"]
[ext_resource type="Resource" path="res://Resources/Items/LightArmor.tres" id="5_light_armor"]
[ext_resource type="Resource" path="res://Resources/Items/FragGrenade.tres" id="6_frag_grenade"]

[sub_resource type="Resource" id="Resource_rifle"]
script = ExtResource("3_stack")
item = ExtResource("4_rifle")
count = 1

[sub_resource type="Resource" id="Resource_light_armor"]
script = ExtResource("3_stack")
item = ExtResource("5_light_armor")
count = 1

[sub_resource type="Resource" id="Resource_frag_grenade"]
script = ExtResource("3_stack")
item = ExtResource("6_frag_grenade")
count = 5

[sub_resource type="Resource" id="Resource_stock"]
script = ExtResource("2_inventory")
stacks = Array[ExtResource("3_stack")]([SubResource("Resource_rifle"), SubResource("Resource_light_armor"), SubResource("Resource_frag_grenade")])

[resource]
script = ExtResource("1_market")
display_name = "Market"
description = "Traders here deal in weapons, armor and supplies."
stock = SubResource("Resource_stock")
