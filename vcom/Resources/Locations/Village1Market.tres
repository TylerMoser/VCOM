[sub_resource type="Resource" id="Resource_rifle"]
script = ExtResource("3_stack")
item = ExtResource("4_rifle")

[sub_resource type="Resource" id="Resource_shortsword"]
script = ExtResource("3_stack")
item = ExtResource("7_shortsword")
count = 2

[sub_resource type="Resource" id="Resource_light_armor"]
script = ExtResource("3_stack")
item = ExtResource("5_light_armor")

[sub_resource type="Resource" id="Resource_frag_grenade"]
script = ExtResource("3_stack")
item = ExtResource("6_frag_grenade")
